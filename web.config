<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config
  ----------
  IIS site configuration for hosting the Prisma CSE Reports Flask app
  via the httpPlatformHandler module (NOT wfastcgi — see note below).

  Why httpPlatformHandler instead of wfastcgi/FastCGI:
    This app keeps report jobs in an in-memory dict and processes each
    report in a background thread of the same worker process that
    accepted the HTTP request. FastCGI (wfastcgi) manages a POOL of
    worker processes, so a status-poll request could land on a
    different process than the one running the job and get 404'd.
    httpPlatformHandler instead launches ONE long-lived process
    (a `waitress` WSGI server, see wsgi.py) and proxies all requests to
    it, which matches this app's single-process design.

  ===========================================================================
  REQUIRED ONE-TIME SETUP ON THE IIS SERVER (see also DEPLOY_IIS.md):
  ===========================================================================
  1. The IIS "CGI" feature and "URL Rewrite"/"Application Request Routing"
     modules are NOT required. The only IIS module this config depends on
     is httpPlatformHandler:
       https://www.iis.net/downloads/microsoft/httpplatformhandler
  2. Install Python 3.10+ on the server (or ship a self-contained venv).
  3. Create/activate a virtual environment and install dependencies:
       py -3.13 -m venv .venv
       .venv\Scripts\pip install -r requirements.txt
  4. Edit the processPath and arguments below to point at the venv's
     python.exe (absolute path required by IIS).
  5. In IIS Manager, create a new Application (or Site) whose physical
     path is this project folder, and ensure its Application Pool is
     set to "No Managed Code" (this app is not an ASP.NET app; the
     httpPlatformHandler owns the process lifecycle instead of IIS's
     CLR pipeline).
  6. Grant the Application Pool identity (e.g. IIS AppPool\<poolname>)
     Modify/Write permission on this project folder, since the report
     scripts write output .xlsx/.html/.log files here at runtime.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>

    <httpPlatform processPath="C:\inetpub\wwwroot\Prisma-CSE-Dashboard\.venv\Scripts\python.exe"
                   arguments="-m waitress --listen=127.0.0.1:%HTTP_PLATFORM_PORT% wsgi:app"
                   startupTimeLimit="60"
                   startupRetryCount="3"
                   stdoutLogEnabled="true"
                   stdoutLogFile=".\logs\stdout.log"
                   forwardWindowsAuthToken="false">
      <environmentVariables>
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
      </environmentVariables>
    </httpPlatform>

    <!--
      Report files can take a while to generate for large tenant
      hierarchies; avoid IIS proxy timeouts on the progress-polling and
      download requests.
    -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
