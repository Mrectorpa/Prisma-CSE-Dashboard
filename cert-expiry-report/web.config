<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS configuration for hosting this Flask app via wfastcgi.

  Before this works, you must (see README.md for full steps):
    1. Install Python (64-bit) on the IIS server.
    2. pip install -r requirements.txt   (includes wfastcgi)
    3. Run: wfastcgi-enable
       This registers a FastCGI application in IIS and prints the exact
       <fullPath> and <arguments> values for the handler below - copy
       those into this file, replacing the placeholders.
    4. Set the WSGI_HANDLER, PYTHONPATH, and related appSettings below
       to match your deployment path.
    5. Create/point an IIS website or application at this folder, with
       an Application Pool set to "No Managed Code".

  Placeholders to replace:
    C:\path\to\python.exe           -> full path to your Python interpreter
    C:\path\to\wfastcgi.py          -> full path to wfastcgi.py in site-packages
    C:\path\to\cert-expiry-report   -> full deployment path of this folder
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="FlaskFastCGI"
           path="*"
           verb="*"
           modules="FastCgiModule"
           scriptProcessor="C:\path\to\python.exe|C:\path\to\wfastcgi.py"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <!-- Serve static files (CSS) directly instead of routing them through
         Flask/FastCGI, for better performance. -->
    <staticContent>
      <mimeMap fileExtension=".css" mimeType="text/css" />
    </staticContent>

    <!-- Limit request size (this app only accepts a small credentials
         form, so keep this modest). -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="1048576" />
      </requestFiltering>
    </security>
  </system.webServer>

  <appSettings>
    <!-- Tells wfastcgi which WSGI application object to load. -->
    <add key="WSGI_HANDLER" value="wsgi.app" />

    <!-- Ensures the app package is importable regardless of IIS's
         working directory. -->
    <add key="PYTHONPATH" value="C:\path\to\cert-expiry-report" />

    <!-- Optional: override the log level (DEBUG, INFO, WARNING, ERROR). -->
    <add key="CERT_REPORT_LOG_LEVEL" value="INFO" />

    <!-- Recommended: set a stable secret key in production instead of
         the random one generated per-process by app/__init__.py. -->
    <!-- <add key="CERT_REPORT_SECRET_KEY" value="replace-with-a-random-value" /> -->
  </appSettings>
</configuration>
